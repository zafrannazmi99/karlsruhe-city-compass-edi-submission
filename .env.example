# Copy to .env, then set a private secret and a reachable Ollama endpoint.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=karlsruhe_places
WALKING_ROUTER_URL=https://routing.openstreetmap.de/routed-foot
WALKING_ROUTER_TIMEOUT_SECONDS=4
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SECRET_KEY=replace-with-a-long-random-value
